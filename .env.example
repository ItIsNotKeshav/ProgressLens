# ProgressLens — Environment Variables
#
# Copy this file to a local .cargo/config.toml [env] section or export these
# variables in your shell before running `npm run tauri dev` or `cargo build`.
#
# See docs/security.md for step-by-step Google OAuth setup instructions.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google OAuth 2.0 (required for Google Sheets sync) ───────────────────────
# Obtain from: Google Cloud Console → APIs & Services → Credentials
# Create an "OAuth 2.0 Client ID" of type "Desktop app"
# Add http://localhost:8080 as an Authorized Redirect URI
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE

# ── Google OAuth Endpoints (do not change) ───────────────────────────────────
GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_REDIRECT_URI=http://localhost:8080
GOOGLE_OAUTH_SCOPE=https://www.googleapis.com/auth/spreadsheets.readonly
